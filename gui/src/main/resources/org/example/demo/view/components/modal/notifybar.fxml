<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox fx:id="notifybar" alignment="TOP_CENTER" prefHeight="573.0" prefWidth="428.0" style="-fx-border-radius: 10px; -fx-background-color: #fafafb;" styleClass="notify-bar" stylesheets="@../../style/style.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.demo.view.components.modal.Notification">
   <children>
      <HBox alignment="CENTER" prefHeight="47.0" style="-fx-background-color: #EBEBEB; -fx-background-radius: 10 10 0 0; -fx-border-color: rgba(0,0,0,0.12); -fx-border-width: 0 0 1 0;">
         <children>
            <Label prefHeight="44.0" prefWidth="463.0" text="Notification" textFill="#241f31" HBox.hgrow="ALWAYS">
               <font>
                  <Font name="Cantarell Bold" size="16.0" />
               </font>
               <HBox.margin>
                  <Insets left="20.0" />
               </HBox.margin>
            </Label>
            <Button alignment="CENTER" graphicTextGap="10.0" minHeight="-Infinity" minWidth="-Infinity" mnemonicParsing="false" onAction="#close" prefHeight="23.0" prefWidth="23.0" style="-fx-border-radius: 20px; -fx-background-radius: 20px;" styleClass="btn-close" stylesheets="@../../style/style.css">
               <font>
                  <Font name="Cantarell Regular" size="18.0" />
               </font>
               <graphic>
                  <Region prefHeight="200.0" prefWidth="200.0" styleClass="icon-bell-close" />
               </graphic>
               <HBox.margin>
                  <Insets right="20.0" />
               </HBox.margin>
            </Button>
         </children>
      </HBox>
      <ScrollPane fx:id="scroll" fitToHeight="true" fitToWidth="true" VBox.vgrow="ALWAYS">
         <content>
            <VBox fx:id="cardContainer" />
         </content>
      </ScrollPane>
   </children>
   <effect>
      <DropShadow height="30.0" radius="14.5" width="30.0" />
   </effect>
</VBox>
